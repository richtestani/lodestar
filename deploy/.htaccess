# Routing + Not Found for Apache / Bluehost.
# Copy this into the web root (alongside index.html) when deploying.
#
# `npm run build` writes every page as its own <page>/index.html, so
# Apache serves real pages as plain files. Anything else gets the site's
# Not Found page (public/404.html) with a real 404 status, so search
# engines don't index broken links as pages.
ErrorDocument 404 /404.html
DirectoryIndex index.html

# ── Only if prerendering can't run on your build machine ──
# (the build warns "0 of N routes prerendered"): pages then exist only
# inside the app, so send every unknown path to the app instead. Comment
# out the ErrorDocument line above and uncomment this block. Not Found
# still shows for bad URLs, but with a 200 status.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteBase /
#   RewriteRule ^index\.html$ - [L]
#   RewriteCond %{REQUEST_FILENAME} !-f
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteRule . /index.html [L]
# </IfModule>
