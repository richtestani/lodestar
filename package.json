{
	"license": "MIT",
	"name": "lodestar-starter",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"description": "A reusable Vue 3 + Vite client-site starter. Run `node setup.mjs` to stamp out a new site.",
	"scripts": {
		"new": "node setup.mjs",
		"dev": "vite",
		"build": "vite build && node scripts/prerender.mjs production",
		"build:staging": "vite build --mode staging && node scripts/prerender.mjs staging",
		"preview": "vite preview"
	},
	"dependencies": {
		"markdown-it-anchor": "^9.2.1",
		"unplugin-vue-markdown": "^32.1.1",
		"vue": "^3.5.34",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.6",
		"puppeteer": "^24.15.0",
		"vite": "^8.0.12",
		"vite-svg-loader": "^5.1.1"
	}
}
